{
  "name": "electric",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "高圧受電設備 単線結線図・低圧分電盤図 作成ツール",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "encoding-japanese": "^2.2.0",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
